// ─────────────────────────────────────────────────────────────────────────────
// TABLES DU MODULE « QUIZ »
//
// Les liens vers les tables du moteur (catégorie, utilisateur) sont de simples
// identifiants, sans contrainte en base : le module reste ainsi indépendant.
// ─────────────────────────────────────────────────────────────────────────────

/// Une question de la banque de questions.
model Question {
  id          String   @id @default(cuid())
  /// Identifiant stable et lisible, utilisé dans les packs et les imports (ex. "q-001")
  ref         String   @unique
  /// "single" (choix unique), "multiple" (choix multiple) ou "truefalse" (vrai/faux)
  type        String
  statement   String
  /// Explication affichée avec la correction ; elle doit se suffire à elle-même
  explanation String   @default("")
  /// Difficulté de 1 (facile) à 3 (difficile)
  difficulty  Int      @default(1)
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  options QuestionOption[]
  quizzes QuizQuestion[]
  answers QuizAttemptAnswer[]

  @@index([categoryId])
}

/// Une réponse proposée. Pour un vrai/faux : deux lignes, « vrai » puis « faux ».
model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  label      String
  isCorrect  Boolean  @default(false)
  position   Int      @default(0)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

/// Un quiz : un ensemble de questions, choisies à la main ou tirées au sort.
model Quiz {
  id          String   @id @default(cuid())
  /// Identifiant de l'adresse (/quiz/<slug>), figé à la création
  slug        String   @unique
  title       String
  description String   @default("")
  /// "draft" (brouillon) ou "published" (publié)
  status      String   @default("draft")
  /// Modes proposés : "both", "training" (entraînement) ou "evaluation"
  modes       String   @default("both")
  /// "manual" (questions choisies) ou "rules" (tirage aléatoire selon des règles)
  selection   String   @default("manual")
  /// Texte en minuscules et sans accents, pour la recherche
  searchText  String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions QuizQuestion[]
  rules     QuizRule[]
  attempts  QuizAttempt[]
}

/// Question choisie à la main dans un quiz, avec sa position.
model QuizQuestion {
  quizId     String
  questionId String
  position   Int      @default(0)
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([quizId, questionId])
}

/// Règle de tirage : « N questions de telle catégorie et de telle difficulté ».
model QuizRule {
  id         String  @id @default(cuid())
  quizId     String
  /// Vide = toutes les catégories
  categoryId String?
  /// Vide = toutes les difficultés
  difficulty Int?
  count      Int
  position   Int     @default(0)
  quiz       Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

/// Une tentative d'un membre. Elle mémorise les questions tirées et l'ordre mélangé des
/// réponses : recharger la page ne redistribue rien.
model QuizAttempt {
  id           String    @id @default(cuid())
  quizId       String
  userId       String
  /// "training" ou "evaluation"
  mode         String
  /// Liste ordonnée : [{ "q": idQuestion, "o": [idsDesRéponsesDansLOrdreAffiché] }]
  draw         Json
  /// Numéro (à partir de 0) de la question en cours
  currentIndex Int       @default(0)
  total        Int
  score        Int?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  quiz         Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  answers QuizAttemptAnswer[]

  @@index([userId, startedAt])
  @@index([quizId])
}

model QuizAttemptAnswer {
  id         String      @id @default(cuid())
  attemptId  String
  questionId String
  /// Identifiants des réponses cochées
  selected   Json
  isCorrect  Boolean
  answeredAt DateTime    @default(now())
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}
